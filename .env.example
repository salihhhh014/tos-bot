# скопируй в .env, значения не коммитить
BOT_TOKEN=123456:xxx
# основной чат: Groq + Qwen.
# какую модель: самую маленькую Qwen с контекстом от 32k.
# id смотри в консоли Groq (они их переименовывают)
OPENAI_API_KEY=gsk-xxx
OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# запасной чат на случай 429. пусто = выключен
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
ALLOWED_USER_IDS=
MAX_DOC_CHARS=60000
MAX_FILE_MB=10
URL_FETCH_TIMEOUT_SEC=15
CHUNK_CONCURRENCY=2
DAILY_LIMIT_PER_USER=30
QUOTA_DB_PATH=data/quota.db
CACHE_MAX_ENTRIES=200
CACHE_TTL_HOURS=168
# сканы и фото: без OCR-ключа не распознаются, остальное работает.
# OCR-эндпоинт есть только у Mistral — ключ только оттуда
OCR_ENABLED=1
OCR_MODEL=mistral-ocr-latest
OCR_API_KEY=
OCR_BASE_URL=
OCR_TIMEOUT_SEC=90
LOG_LEVEL=INFO
